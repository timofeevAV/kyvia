#!/bin/bash
# Show a kyvia toast: kyvia (or kv) [-t success|error|warning|info|action] [-d ms] TITLE [DESCRIPTION]
# kyvia ask: a Claude Code hook that answers AskUserQuestion and permission requests from a toast.
set -euo pipefail
usage() {
    echo "usage: ${0##*/} [-t success|error|warning|info|action] [-d ms] TITLE [DESCRIPTION]" >&2
    echo "       ${0##*/} ask    answer Claude Code's questions and permission requests from a toast; reads the hook input" >&2
    exit 2
}
# Prints the hook output for the option picked on the toast; prints nothing (the terminal asks) otherwise.
# An empty Expect stops curl from waiting a second before sending a large PostToolUse body.
if [[ ${1:-} == ask ]]; then
    curl -s -m 150 -H 'X-Kyvia: 1' -H 'Expect:' -H "X-Kyvia-App: ${__CFBundleIdentifier:-}" --data-binary @- \
        http://127.0.0.1:47321/ask || true
    exit 0
fi
type=info duration=
while getopts t:d:h opt; do
    case $opt in t) type=$OPTARG ;; d) duration=$OPTARG ;; *) usage ;; esac
done
shift $((OPTIND - 1))
[[ $# -ge 1 && $# -le 2 ]] || usage
[[ -z $duration || $duration =~ ^[0-9]+$ ]] || usage
# JSON comes from JavaScript for Automation, so any text is escaped correctly without jq.
# app and path let a click on the toast bring this terminal (and, in VS Code, this window) forward.
osascript -l JavaScript -e 'function run(a) {
    const p = {type: a[0], title: a[1], description: a[2], app: a[4], path: a[5]}
    if (a[3]) p.duration = Number(a[3])
    return JSON.stringify(p) }' -- "$type" "$1" "${2:-}" "$duration" "${__CFBundleIdentifier:-}" "$PWD" |
    curl -sf -m 2 -o /dev/null -H 'X-Kyvia: 1' --data-binary @- http://127.0.0.1:47321/notify ||
    { echo "kyvia: the app is not running (127.0.0.1:47321)" >&2; exit 1; }
